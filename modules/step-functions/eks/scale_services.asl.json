{
  "Comment": "Cross-account: Scales a list of EKS services (Deployments, StatefulSets) to a specified number of replicas. Supports both public (eks:call) and private (k8s-proxy Lambda) access modes via CheckAccessMode routing on $.EKS.AccessMode.",
  "StartAt": "CheckAccessMode",
  "States": {
    "CheckAccessMode": {
      "Type": "Choice",
      "Comment": "Route to public (eks:call via GetEksClusterInfo) or private (lambda:invoke) flow based on EKS.AccessMode",
      "Choices": [
        {
          "Variable": "$.EKS.AccessMode",
          "StringEquals": "public",
          "Next": "GetEksClusterInfo"
        }
      ],
      "Default": "InitPrivateDefaults"
    },
    "InitPrivateDefaults": {
      "Type": "Pass",
      "QueryLanguage": "JSONata",
      "Comment": "Inject stub EksCluster and optional EksRoleArn for private mode. EksRoleArn is set only when EKS.Account.RoleArn differs from DestinationAccount.RoleArn (legacy clusters with separate K8s access role via aws-auth).",
      "Output": "{% $merge([$states.input, {'EksCluster': {'Cluster': {'Name': 'unused', 'CertificateAuthority': {'Data': 'unused'}, 'Endpoint': 'unused'}}, 'EksRoleArn': ($exists($states.input.EKS.Account.RoleArn) and $states.input.EKS.Account.RoleArn != $states.input.DestinationAccount.RoleArn) ? $states.input.EKS.Account.RoleArn : null}]) %}",
      "Next": "ResolveSecretRefresh"
    },
    "GetEksClusterInfo": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:eks:describeCluster",
      "Parameters": {
        "Name.$": "$.EKS.ClusterName"
      },
      "Credentials": {
        "RoleArn.$": "$.DestinationAccount.RoleArn"
      },
      "ResultPath": "$.EksCluster",
      "Next": "SetPublicEksRoleArn",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.Error",
          "Next": "ScaleFailed"
        }
      ]
    },
    "SetPublicEksRoleArn": {
      "Type": "Pass",
      "Comment": "Set EksRoleArn to null for public mode (not needed with EKS Access Entries).",
      "Result": null,
      "ResultPath": "$.EksRoleArn",
      "Next": "ResolveSecretRefresh"
    },
    "ResolveSecretRefresh": {
      "Type": "Pass",
      "QueryLanguage": "JSONata",
      "Comment": "Resolve secret refresh mode: 'annotate' (ESO ExternalSecret), 'delete' (Secret Provider Class), or 'none'. Falls back to CleanupSecret for backward compatibility. In annotate mode with Replicas > 0, the ExternalSecret is force-synced and awaited BEFORE scaling up (PreScaleSync), so pods never start with a stale Secret. Optional EKS.SecretRefresh fields: ExternalSecretName (default SecretName), Namespace (default EKS.Namespace), ApiVersion (default v1), SecretKey (Secret key to compare with the expected value), ExpectedValueSSMParameter (default input ExpectedSecretValueSSMParameter), WaitTimeoutSeconds (default 300, 0 disables the wait), PollIntervalSeconds (default 10).",
      "Output": "{% $merge([$states.input, {'SecretRefreshResolved': ( $sr := $states.input.EKS.SecretRefresh; $mode := $exists($sr.Mode) ? $sr.Mode : ($states.input.CleanupSecret = true and $states.input.Replicas > 0 ? 'delete' : 'none'); $name := $exists($sr.SecretName) ? $sr.SecretName : 'shared-data-media-sub-path'; $timeout := ($exists($sr.WaitTimeoutSeconds) and $sr.WaitTimeoutSeconds >= 0) ? $sr.WaitTimeoutSeconds : 300; $interval := ($exists($sr.PollIntervalSeconds) and $sr.PollIntervalSeconds > 0) ? $sr.PollIntervalSeconds : 10; {'Mode': $mode, 'SecretName': $name, 'ExternalSecretName': ($exists($sr.ExternalSecretName) and $sr.ExternalSecretName != '') ? $sr.ExternalSecretName : $name, 'Namespace': ($exists($sr.Namespace) and $sr.Namespace != '') ? $sr.Namespace : $states.input.EKS.Namespace, 'ApiVersion': ($exists($sr.ApiVersion) and $sr.ApiVersion != '') ? $sr.ApiVersion : 'v1', 'SecretKey': ($exists($sr.SecretKey) and $sr.SecretKey != '') ? $sr.SecretKey : null, 'ExpectedValueSSMParameter': ($exists($sr.ExpectedValueSSMParameter) and $sr.ExpectedValueSSMParameter != '') ? $sr.ExpectedValueSSMParameter : (($exists($states.input.ExpectedSecretValueSSMParameter) and $states.input.ExpectedSecretValueSSMParameter != '') ? $states.input.ExpectedSecretValueSSMParameter : null), 'WaitTimeoutSeconds': $timeout, 'PollIntervalSeconds': $interval, 'MaxPolls': $timeout > 0 ? $ceil($timeout / $interval) : 0, 'PreScaleSync': $mode = 'annotate' and $states.input.Replicas > 0} )}]) %}",
      "Next": "CheckPreScaleSecretSync"
    },
    "CheckPreScaleSecretSync": {
      "Type": "Choice",
      "Comment": "Scaling up with an ESO ExternalSecret: force-sync it and wait for the Secret before starting pods",
      "Choices": [
        {
          "Variable": "$.SecretRefreshResolved.PreScaleSync",
          "BooleanEquals": true,
          "Next": "SecretSyncInit"
        }
      ],
      "Default": "ScaleServicesMap"
    },
    "SecretSyncInit": {
      "Type": "Pass",
      "QueryLanguage": "JSONata",
      "Assign": {
        "syncCfg": "{% $states.input.SecretRefreshResolved %}",
        "syncEsPath": "{% '/apis/external-secrets.io/' & $states.input.SecretRefreshResolved.ApiVersion & '/namespaces/' & $states.input.SecretRefreshResolved.Namespace & '/externalsecrets/' & $states.input.SecretRefreshResolved.ExternalSecretName %}",
        "syncForceSyncAt": "{% $now() %}",
        "syncForceSyncAttempts": 0,
        "syncPolls": 0,
        "syncEs": null,
        "syncMode": null,
        "syncTargetSecret": null,
        "syncExpected": null,
        "syncObserved": null,
        "syncLastError": null
      },
      "Next": "SecretSyncCheckExpectedSource"
    },
    "SecretSyncCheckExpectedSource": {
      "Type": "Choice",
      "QueryLanguage": "JSONata",
      "Comment": "With a SecretKey and an SSM parameter, wait for the Secret value itself; otherwise wait for the ExternalSecret refreshTime",
      "Choices": [
        {
          "Condition": "{% $syncCfg.SecretKey != null and $syncCfg.ExpectedValueSSMParameter != null %}",
          "Next": "SecretSyncGetExpectedValue"
        }
      ],
      "Default": "SecretSyncCheckAccessMode"
    },
    "SecretSyncGetExpectedValue": {
      "Type": "Task",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::aws-sdk:ssm:getParameter",
      "Credentials": {
        "RoleArn": "{% $states.input.DestinationAccount.RoleArn %}"
      },
      "Arguments": {
        "Name": "{% $syncCfg.ExpectedValueSSMParameter %}"
      },
      "Assign": {
        "syncExpected": "{% $states.result.Parameter.Value %}"
      },
      "Output": "{% $states.input %}",
      "Next": "SecretSyncCheckAccessMode",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed", "States.Timeout"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": {
            "syncLastError": "{% $states.errorOutput %}"
          },
          "Output": "{% $states.input %}",
          "Next": "SecretSyncCheckAccessMode"
        }
      ]
    },
    "SecretSyncCheckAccessMode": {
      "Type": "Choice",
      "QueryLanguage": "JSONata",
      "Choices": [
        {
          "Condition": "{% $states.input.EKS.AccessMode = 'public' %}",
          "Next": "SecretSyncGetExternalSecret"
        }
      ],
      "Default": "SecretSyncForceSyncPrivate"
    },
    "SecretSyncGetExternalSecret": {
      "Type": "Task",
      "QueryLanguage": "JSONata",
      "Comment": "Public mode: read the ExternalSecret, then PUT it back with a new force-sync annotation",
      "Resource": "arn:aws:states:::eks:call",
      "Arguments": {
        "ClusterName": "{% $states.input.EksCluster.Cluster.Name %}",
        "CertificateAuthority": "{% $states.input.EksCluster.Cluster.CertificateAuthority.Data %}",
        "Endpoint": "{% $states.input.EksCluster.Cluster.Endpoint %}",
        "Method": "GET",
        "Path": "{% $syncEsPath %}"
      },
      "Credentials": {
        "RoleArn": "{% $states.input.DestinationAccount.RoleArn %}"
      },
      "Assign": {
        "syncEs": "{% $states.result.ResponseBody %}",
        "syncForceSyncAttempts": "{% $syncForceSyncAttempts + 1 %}"
      },
      "Output": "{% $states.input %}",
      "Next": "SecretSyncForceSyncPublic",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": {
            "syncLastError": "{% $states.errorOutput %}"
          },
          "Output": "{% $states.input %}",
          "Next": "SecretSyncForceSyncError"
        }
      ]
    },
    "SecretSyncForceSyncPublic": {
      "Type": "Task",
      "QueryLanguage": "JSONata",
      "Resource": "arn:aws:states:::eks:call",
      "Arguments": {
        "ClusterName": "{% $states.input.EksCluster.Cluster.Name %}",
        "CertificateAuthority": "{% $states.input.EksCluster.Cluster.CertificateAuthority.Data %}",
        "Endpoint": "{% $states.input.EksCluster.Cluster.Endpoint %}",
        "Method": "PUT",
        "Path": "{% $syncEsPath %}",
        "RequestBody": "{% $merge([$sift($syncEs, function($v, $k) { $k != 'status' }), {'metadata': $merge([$syncEs.metadata, {'annotations': $merge([$exists($syncEs.metadata.annotations) ? $syncEs.metadata.annotations : {}, {'force-sync': $syncForceSyncAt}])}])}]) %}"
      },
      "Credentials": {
        "RoleArn": "{% $states.input.DestinationAccount.RoleArn %}"
      },
      "Assign": {
        "syncEs": "{% $states.result.ResponseBody %}"
      },
      "Output": "{% $states.input %}",
      "Next": "SecretSyncResolveTarget",
      "Catch": [
        {
          "ErrorEquals": ["EKS.409"],
          "Assign": {
            "syncLastError": "{% $states.errorOutput %}"
          },
          "Output": "{% $states.input %}",
          "Next": "SecretSyncCheckForceSyncRetry"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": {
            "syncLastError": "{% $states.errorOutput %}"
          },
          "Output": "{% $states.input %}",
          "Next": "SecretSyncForceSyncError"
        }
      ]
    },
    "SecretSyncCheckForceSyncRetry": {
      "Type": "Choice",
      "QueryLanguage": "JSONata",
      "Comment": "The ExternalSecret changed between GET and PUT (409 Conflict): read it again, up to 3 times",
      "Choices": [
        {
          "Condition": "{% $syncForceSyncAttempts < 3 %}",
          "Next": "SecretSyncGetExternalSecret"
        }
      ],
      "Default": "SecretSyncForceSyncError"
    },
    "SecretSyncForceSyncPrivate": {
      "Type": "Task",
      "QueryLanguage": "JSONata",
      "Comment": "Private mode: merge-patch the force-sync annotation through the k8s-proxy Lambda",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "{% $states.input.K8sProxyLambdaArn %}",
        "Payload": {
          "Action": "call",
          "ClusterName": "{% $states.input.EKS.ClusterName %}",
          "EksRoleArn": "{% $states.input.EksRoleArn %}",
          "Method": "PATCH",
          "Path": "{% $syncEsPath %}",
          "RequestBody": {
            "metadata": {
              "annotations": {
                "force-sync": "{% $syncForceSyncAt %}"
              }
            }
          },
          "ContentType": "application/merge-patch+json"
        }
      },
      "Credentials": {
        "RoleArn": "{% $states.input.DestinationAccount.RoleArn %}"
      },
      "Assign": {
        "syncEs": "{% $states.result.Payload.ResponseBody %}"
      },
      "Output": "{% $states.input %}",
      "Next": "SecretSyncResolveTarget",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": {
            "syncLastError": "{% $states.errorOutput %}"
          },
          "Output": "{% $states.input %}",
          "Next": "SecretSyncForceSyncError"
        }
      ]
    },
    "SecretSyncForceSyncError": {
      "Type": "Choice",
      "QueryLanguage": "JSONata",
      "Comment": "Force-sync failed: fatal when the wait is enabled, best-effort (scale anyway) when WaitTimeoutSeconds is 0",
      "Choices": [
        {
          "Condition": "{% $syncCfg.MaxPolls > 0 %}",
          "Next": "SecretSyncForceSyncFailed"
        }
      ],
      "Default": "ScaleServicesMap"
    },
    "SecretSyncResolveTarget": {
      "Type": "Pass",
      "QueryLanguage": "JSONata",
      "Comment": "Target Secret = spec.target.name of the ExternalSecret, else its name. Wait on the Secret key when the expected value is known (SecretValue), else on the ExternalSecret status (RefreshTime).",
      "Assign": {
        "syncMode": "{% ($syncCfg.SecretKey != null and $syncExpected != null) ? 'SecretValue' : 'RefreshTime' %}",
        "syncTargetSecret": "{% ($exists($syncEs.spec.target.name) and $syncEs.spec.target.name != '') ? $syncEs.spec.target.name : $syncCfg.ExternalSecretName %}"
      },
      "Next": "SecretSyncCheckWaitEnabled"
    },
    "SecretSyncCheckWaitEnabled": {
      "Type": "Choice",
      "QueryLanguage": "JSONata",
      "Choices": [
        {
          "Condition": "{% $syncCfg.MaxPolls > 0 %}",
          "Next": "SecretSyncWait"
        }
      ],
      "Default": "ScaleServicesMap"
    },
    "SecretSyncWait": {
      "Type": "Wait",
      "QueryLanguage": "JSONata",
      "Seconds": "{% $syncCfg.PollIntervalSeconds %}",
      "Next": "SecretSyncCheckAccessModeForPoll"
    },
    "SecretSyncCheckAccessModeForPoll": {
      "Type": "Choice",
      "QueryLanguage": "JSONata",
      "Choices": [
        {
          "Condition": "{% $states.input.EKS.AccessMode = 'public' %}",
          "Next": "SecretSyncPollPublic"
        }
      ],
      "Default": "SecretSyncPollPrivate"
    },
    "SecretSyncPollPublic": {
      "Type": "Task",
      "QueryLanguage": "JSONata",
      "Comment": "Public mode: eks:call returns the whole object, only the compared key (decoded) or the status is kept",
      "Resource": "arn:aws:states:::eks:call",
      "Arguments": {
        "ClusterName": "{% $states.input.EksCluster.Cluster.Name %}",
        "CertificateAuthority": "{% $states.input.EksCluster.Cluster.CertificateAuthority.Data %}",
        "Endpoint": "{% $states.input.EksCluster.Cluster.Endpoint %}",
        "Method": "GET",
        "Path": "{% $syncMode = 'SecretValue' ? '/api/v1/namespaces/' & $syncCfg.Namespace & '/secrets/' & $syncTargetSecret : $syncEsPath %}"
      },
      "Credentials": {
        "RoleArn": "{% $states.input.DestinationAccount.RoleArn %}"
      },
      "Assign": {
        "syncPolls": "{% $syncPolls + 1 %}",
        "syncObserved": "{% $syncMode = 'SecretValue' ? {'value': $exists($lookup($states.result.ResponseBody.data, $syncCfg.SecretKey)) ? $base64decode($lookup($states.result.ResponseBody.data, $syncCfg.SecretKey)) : null} : {'status': $states.result.ResponseBody.status} %}"
      },
      "Output": "{% $states.input %}",
      "Next": "SecretSyncEvaluate",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": {
            "syncPolls": "{% $syncPolls + 1 %}",
            "syncObserved": null,
            "syncLastError": "{% $states.errorOutput %}"
          },
          "Output": "{% $states.input %}",
          "Next": "SecretSyncEvaluate"
        }
      ]
    },
    "SecretSyncPollPrivate": {
      "Type": "Task",
      "QueryLanguage": "JSONata",
      "Comment": "Private mode: getSecretValue returns only the compared key, decoded; call GET reads the ExternalSecret status",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "{% $states.input.K8sProxyLambdaArn %}",
        "Payload": "{% $syncMode = 'SecretValue' ? {'Action': 'getSecretValue', 'ClusterName': $states.input.EKS.ClusterName, 'EksRoleArn': $states.input.EksRoleArn, 'Namespace': $syncCfg.Namespace, 'SecretName': $syncTargetSecret, 'Key': $syncCfg.SecretKey} : {'Action': 'call', 'ClusterName': $states.input.EKS.ClusterName, 'EksRoleArn': $states.input.EksRoleArn, 'Method': 'GET', 'Path': $syncEsPath} %}"
      },
      "Credentials": {
        "RoleArn": "{% $states.input.DestinationAccount.RoleArn %}"
      },
      "Assign": {
        "syncPolls": "{% $syncPolls + 1 %}",
        "syncObserved": "{% $syncMode = 'SecretValue' ? {'value': $states.result.Payload.Value} : {'status': $states.result.Payload.ResponseBody.status} %}"
      },
      "Output": "{% $states.input %}",
      "Next": "SecretSyncEvaluate",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": {
            "syncPolls": "{% $syncPolls + 1 %}",
            "syncObserved": null,
            "syncLastError": "{% $states.errorOutput %}"
          },
          "Output": "{% $states.input %}",
          "Next": "SecretSyncEvaluate"
        }
      ]
    },
    "SecretSyncEvaluate": {
      "Type": "Choice",
      "QueryLanguage": "JSONata",
      "Choices": [
        {
          "Condition": "{% $syncMode = 'SecretValue' and $exists($syncObserved.value) and $syncObserved.value = $syncExpected %}",
          "Next": "ScaleServicesMap"
        },
        {
          "Condition": "{% $syncMode = 'RefreshTime' and $exists($syncObserved.status.refreshTime) and $toMillis($syncObserved.status.refreshTime) >= $floor($toMillis($syncForceSyncAt) / 1000) * 1000 and $count($syncObserved.status.conditions[type = 'Ready' and status = 'True']) > 0 %}",
          "Next": "ScaleServicesMap"
        },
        {
          "Condition": "{% $syncPolls >= $syncCfg.MaxPolls %}",
          "Next": "SecretSyncTimeout"
        }
      ],
      "Default": "SecretSyncWait"
    },
    "SecretSyncTimeout": {
      "Type": "Fail",
      "QueryLanguage": "JSONata",
      "Error": "ExternalSecretSyncTimeout",
      "Cause": "{% 'ExternalSecret ' & $syncCfg.Namespace & '/' & $syncCfg.ExternalSecretName & ' did not sync within ' & $string($syncCfg.WaitTimeoutSeconds) & 's after force-sync (wait mode ' & $syncMode & '); services were not scaled up. Last poll error: ' & $string($syncLastError) %}"
    },
    "SecretSyncForceSyncFailed": {
      "Type": "Fail",
      "QueryLanguage": "JSONata",
      "Error": "ExternalSecretForceSyncFailed",
      "Cause": "{% 'Could not force-sync ExternalSecret ' & $syncCfg.Namespace & '/' & $syncCfg.ExternalSecretName & ' at ' & $syncEsPath & ' (check EKS.SecretRefresh ExternalSecretName, Namespace, ApiVersion and RBAC on externalsecrets.external-secrets.io); services were not scaled up. Error: ' & $string($syncLastError) %}"
    },
    "ScaleServicesMap": {
      "Type": "Map",
      "ItemsPath": "$.EKS.Services",
      "ItemSelector": {
        "AccessMode.$": "$.EKS.AccessMode",
        "ClusterName.$": "$.EksCluster.Cluster.Name",
        "CertificateAuthority.$": "$.EksCluster.Cluster.CertificateAuthority.Data",
        "Endpoint.$": "$.EksCluster.Cluster.Endpoint",
        "K8sProxyLambdaArn.$": "$.K8sProxyLambdaArn",
        "EksClusterName.$": "$.EKS.ClusterName",
        "Namespace.$": "$.EKS.Namespace",
        "Replicas.$": "$.Replicas",
        "ServiceName.$": "$$.Map.Item.Value.Name",
        "ServiceType.$": "$$.Map.Item.Value.Kind",
        "DestinationAccount.$": "$.DestinationAccount",
        "EksRoleArn.$": "$.EksRoleArn"
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "CheckAccessModeForPatch",
        "States": {
          "CheckAccessModeForPatch": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.AccessMode",
                "StringEquals": "public",
                "Next": "PatchService"
              }
            ],
            "Default": "PatchServicePrivate"
          },
          "PatchService": {
            "Type": "Task",
            "Resource": "arn:aws:states:::eks:call",
            "Parameters": {
              "ClusterName.$": "$.ClusterName",
              "CertificateAuthority.$": "$.CertificateAuthority",
              "Endpoint.$": "$.Endpoint",
              "Method": "PATCH",
              "Path.$": "States.Format('/apis/apps/v1/namespaces/{}/{}/{}/scale', $.Namespace, $.ServiceType, $.ServiceName)",
              "RequestBody": {
                "spec": {
                  "replicas.$": "$.Replicas"
                }
              }
            },
            "Credentials": {
              "RoleArn.$": "$.DestinationAccount.RoleArn"
            },
            "ResultPath": "$.PatchResult",
            "Next": "WaitForScale",
            "Retry": [
              {
                "ErrorEquals": ["States.TaskFailed"],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["EKS.404"],
                "ResultPath": "$.PatchError",
                "Next": "ServiceNotFoundSkip"
              }
            ]
          },
          "PatchServicePrivate": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "$.K8sProxyLambdaArn",
              "Payload": {
                "Action": "call",
                "ClusterName.$": "$.EksClusterName",
                "EksRoleArn.$": "$.EksRoleArn",
                "Method": "PATCH",
                "Path.$": "States.Format('/apis/apps/v1/namespaces/{}/{}/{}/scale', $.Namespace, $.ServiceType, $.ServiceName)",
                "RequestBody": {
                  "spec": {
                    "replicas.$": "$.Replicas"
                  }
                }
              }
            },
            "Credentials": {
              "RoleArn.$": "$.DestinationAccount.RoleArn"
            },
            "ResultSelector": {
              "ResponseBody.$": "$.Payload.ResponseBody",
              "StatusCode.$": "$.Payload.StatusCode"
            },
            "ResultPath": "$.PatchResult",
            "Next": "WaitForScale",
            "Retry": [
              {
                "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["States.TaskFailed"],
                "ResultPath": "$.PatchError",
                "Next": "ServiceNotFoundSkip"
              }
            ]
          },
          "ServiceNotFoundSkip": {
            "Type": "Pass",
            "Parameters": {
              "ServiceName.$": "$.ServiceName",
              "Status": "Skipped",
              "Reason": "Service not found"
            },
            "End": true
          },
          "WaitForScale": {
            "Type": "Wait",
            "Seconds": 5,
            "End": true
          }
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.Error",
          "Next": "ScaleFailed"
        }
      ],
      "ResultPath": "$.MapResult",
      "Next": "WaitAfterScaling"
    },
    "WaitAfterScaling": {
      "Type": "Wait",
      "Seconds": 10,
      "Next": "CheckSecretRefreshMode"
    },
    "CheckSecretRefreshMode": {
      "Type": "Choice",
      "Comment": "Route to annotate (ESO, only when not already synced before scaling), delete (SPC/legacy), or skip secret refresh",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.SecretRefreshResolved.Mode",
              "StringEquals": "annotate"
            },
            {
              "Variable": "$.SecretRefreshResolved.PreScaleSync",
              "BooleanEquals": false
            }
          ],
          "Next": "CheckAccessModeForAnnotate"
        },
        {
          "Variable": "$.SecretRefreshResolved.Mode",
          "StringEquals": "delete",
          "Next": "CheckAccessModeForDelete"
        }
      ],
      "Default": "PrepareOutput"
    },

    "CheckAccessModeForAnnotate": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.EKS.AccessMode",
          "StringEquals": "public",
          "Next": "AnnotateExternalSecret"
        }
      ],
      "Default": "AnnotateExternalSecretPrivate"
    },
    "AnnotateExternalSecret": {
      "Type": "Task",
      "Comment": "Force ESO to resync ExternalSecret from SSM by updating annotation",
      "Resource": "arn:aws:states:::eks:call",
      "Parameters": {
        "ClusterName.$": "$.EksCluster.Cluster.Name",
        "CertificateAuthority.$": "$.EksCluster.Cluster.CertificateAuthority.Data",
        "Endpoint.$": "$.EksCluster.Cluster.Endpoint",
        "Method": "PATCH",
        "Path.$": "States.Format('/apis/external-secrets.io/{}/namespaces/{}/externalsecrets/{}', $.SecretRefreshResolved.ApiVersion, $.SecretRefreshResolved.Namespace, $.SecretRefreshResolved.ExternalSecretName)",
        "RequestBody": {
          "metadata": {
            "annotations": {
              "force-sync.$": "$$.State.EnteredTime"
            }
          }
        }
      },
      "Credentials": {
        "RoleArn.$": "$.DestinationAccount.RoleArn"
      },
      "ResultPath": "$.AnnotateResult",
      "Next": "PrepareOutput",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.AnnotateError",
          "Next": "PrepareOutput"
        }
      ]
    },
    "AnnotateExternalSecretPrivate": {
      "Type": "Task",
      "Comment": "Force ESO to resync ExternalSecret from SSM by updating annotation (private mode via k8s-proxy Lambda)",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName.$": "$.K8sProxyLambdaArn",
        "Payload": {
          "Action": "call",
          "ClusterName.$": "$.EKS.ClusterName",
          "EksRoleArn.$": "$.EksRoleArn",
          "Method": "PATCH",
          "Path.$": "States.Format('/apis/external-secrets.io/{}/namespaces/{}/externalsecrets/{}', $.SecretRefreshResolved.ApiVersion, $.SecretRefreshResolved.Namespace, $.SecretRefreshResolved.ExternalSecretName)",
          "RequestBody": {
            "metadata": {
              "annotations": {
                "force-sync.$": "$$.State.EnteredTime"
              }
            }
          }
        }
      },
      "Credentials": {
        "RoleArn.$": "$.DestinationAccount.RoleArn"
      },
      "ResultSelector": {
        "ResponseBody.$": "$.Payload.ResponseBody",
        "StatusCode.$": "$.Payload.StatusCode"
      },
      "ResultPath": "$.AnnotateResult",
      "Next": "PrepareOutput",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.AnnotateError",
          "Next": "PrepareOutput"
        }
      ]
    },

    "CheckAccessModeForDelete": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.EKS.AccessMode",
          "StringEquals": "public",
          "Next": "GetSecret"
        }
      ],
      "Default": "GetSecretPrivate"
    },
    "GetSecret": {
      "Type": "Task",
      "Resource": "arn:aws:states:::eks:call",
      "Parameters": {
        "ClusterName.$": "$.EksCluster.Cluster.Name",
        "CertificateAuthority.$": "$.EksCluster.Cluster.CertificateAuthority.Data",
        "Endpoint.$": "$.EksCluster.Cluster.Endpoint",
        "Method": "GET",
        "Path.$": "States.Format('/api/v1/namespaces/{}/secrets/{}', $.EKS.Namespace, $.SecretRefreshResolved.SecretName)"
      },
      "Credentials": {
        "RoleArn.$": "$.DestinationAccount.RoleArn"
      },
      "ResultPath": "$.SecretResult",
      "Next": "DeleteSecret",
      "Catch": [
        {
          "ErrorEquals": ["EKS.404"],
          "ResultPath": "$.SecretError",
          "Next": "PrepareOutput"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.SecretError",
          "Next": "PrepareOutput"
        }
      ]
    },
    "GetSecretPrivate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName.$": "$.K8sProxyLambdaArn",
        "Payload": {
          "Action": "call",
          "ClusterName.$": "$.EKS.ClusterName",
          "EksRoleArn.$": "$.EksRoleArn",
          "Method": "GET",
          "Path.$": "States.Format('/api/v1/namespaces/{}/secrets/{}', $.EKS.Namespace, $.SecretRefreshResolved.SecretName)"
        }
      },
      "Credentials": {
        "RoleArn.$": "$.DestinationAccount.RoleArn"
      },
      "ResultSelector": {
        "ResponseBody.$": "$.Payload.ResponseBody",
        "StatusCode.$": "$.Payload.StatusCode"
      },
      "ResultPath": "$.SecretResult",
      "Next": "DeleteSecretPrivate",
      "Catch": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "ResultPath": "$.SecretError",
          "Next": "PrepareOutput"
        }
      ]
    },
    "DeleteSecret": {
      "Type": "Task",
      "Resource": "arn:aws:states:::eks:call",
      "Parameters": {
        "ClusterName.$": "$.EksCluster.Cluster.Name",
        "CertificateAuthority.$": "$.EksCluster.Cluster.CertificateAuthority.Data",
        "Endpoint.$": "$.EksCluster.Cluster.Endpoint",
        "Method": "DELETE",
        "Path.$": "States.Format('/api/v1/namespaces/{}/secrets/{}', $.EKS.Namespace, $.SecretRefreshResolved.SecretName)"
      },
      "Credentials": {
        "RoleArn.$": "$.DestinationAccount.RoleArn"
      },
      "ResultPath": "$.SecretDeleteResult",
      "Next": "PrepareOutput",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.SecretDeleteError",
          "Next": "PrepareOutput"
        }
      ]
    },
    "DeleteSecretPrivate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName.$": "$.K8sProxyLambdaArn",
        "Payload": {
          "Action": "call",
          "ClusterName.$": "$.EKS.ClusterName",
          "EksRoleArn.$": "$.EksRoleArn",
          "Method": "DELETE",
          "Path.$": "States.Format('/api/v1/namespaces/{}/secrets/{}', $.EKS.Namespace, $.SecretRefreshResolved.SecretName)"
        }
      },
      "Credentials": {
        "RoleArn.$": "$.DestinationAccount.RoleArn"
      },
      "ResultSelector": {
        "ResponseBody.$": "$.Payload.ResponseBody",
        "StatusCode.$": "$.Payload.StatusCode"
      },
      "ResultPath": "$.SecretDeleteResult",
      "Next": "PrepareOutput",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.SecretDeleteError",
          "Next": "PrepareOutput"
        }
      ]
    },
    "PrepareOutput": {
      "Type": "Pass",
      "Parameters": {
        "Status": "Completed",
        "ModuleName": "scale_services",
        "PrimaryIdentifier.$": "$.EKS.ClusterName",
        "Replicas.$": "$.Replicas"
      },
      "Next": "ScaleSucceeded"
    },
    "ScaleFailed": {
      "Type": "Fail",
      "Error": "ScaleFailed",
      "Cause": "Failed to scale EKS services"
    },
    "ScaleSucceeded": {
      "Type": "Succeed"
    }
  }
}
